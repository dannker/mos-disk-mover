#!/bin/bash

PLG_DIR="/boot/optional/plugins/disk-mover"
PID_FILE="/var/run/mos-disk-mover.pid"

install() {
  mkdir -p "$PLG_DIR"
}

uninstall() {
  if [ -f "$PID_FILE" ] ; then
    PID=$(cat "$PID_FILE" 2>/dev/null)
    if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null ; then
      kill "$PID" 2>/dev/null || true
      sleep 1
      kill -9 "$PID" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  fi
}

mos_start() {
  :
}

mos_start_after_services() {
  :
}
